  "projections": [
    {
      "title": "Spider-Man: Brand New Day",
      "distributor": "Sony Pictures",
      "theaters": 4487,
      "confidence": "high",
      "momentum": "rising",
      "rtCritic": 90,
      "metacritic": 70,
      "rangeLow": 300000000,
      "rangeHigh": 365000000,
      "analysis": "Thursday previews (including Wednesday night early shows) confirmed at $75M, shattering Avengers: Endgame's all-time preview record of $60M and blowing past No Way Home's $50M. That pace has trackers now pointing to a $345M+ opening weekend, with some outlets floating a real shot at beating Endgame's all-time domestic-opening record of $365.1M. 90% RT / 70 Metacritic, with an early A CinemaScore. Brand New Day accounts for 49% of this weekend's showtimes as of Wednesday. Spider-Man gets IMAX overseas where The Odyssey's domestic exclusive doesn't apply, supporting a global opening now estimated near $800M+ by Sunday. Official Friday numbers land later today and should sharpen this range considerably.",
      "rulerLow": 250000000,
      "rulerHigh": 400000000,
      "currentEstimate": null
    },
    {
      "title": "The Odyssey",
      "distributor": "Universal",
      "theaters": 3800,
      "confidence": "high",
      "momentum": "stable",
      "rtCritic": 98,
      "metacritic": null,
      "rangeLow": 40000000,
      "rangeHigh": 55000000,
      "analysis": "Third and final IMAX-exclusive weekend before Spider-Man takes over those auditoriums. The confirmed $90M second weekend held better than comparable prestige tentpoles and brought the film to roughly $289.4M domestic and $490M global. The IMAX handoff should create the steepest decline of the run, while strong prestige word-of-mouth supports general-auditorium attendance.",
      "rulerLow": 20000000,
      "rulerHigh": 80000000,
      "currentEstimate": null
    }
