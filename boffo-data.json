  "projections": [
    {
      "title": "Spider-Man: Brand New Day",
      "distributor": "Sony Pictures",
      "theaters": 4487,
      "confidence": "high",
      "momentum": "rising",
      "rtCritic": 90,
      "metacritic": 70,
      "rangeLow": 142000000,
      "rangeHigh": 160000000,
      "analysis": "Thursday tracking has firmed up and it's bullish: Box Office Pro pegs weekend two at $150M-$160M (43% Showtime market share), while Box Office Theory's panel forecasts $142M-$160M. With essentially no direct competition and some IMAX capacity still in play alongside a 98% Rotten Tomatoes Popcornmeter score, Brand New Day has a real shot at beating Star Wars: The Force Awakens' all-time second-weekend record of $149.2M and Avengers: Endgame's $147.4M — both trackers note it's already essentially locked to top Avengers: Infinity War's $114.8M third-place mark. It also just posted the biggest Tuesday in box office history ($42M on Aug 4), pushing its domestic total to $449.15M and making it the #2 domestic performer of 2026 behind Toy Story 5's $463.35M.",
      "rulerLow": 120000000,
      "rulerHigh": 180000000,
      "currentEstimate": null,
      "estimateColorMode": "gradient",
      "estimateColor": "#5C8FF0"
    },
    {
      "title": "One Night Only",
      "distributor": "Universal",
      "theaters": 3000,
      "confidence": "low",
      "momentum": "softening",
      "rtCritic": null,
      "metacritic": null,
      "rangeLow": 3000000,
      "rangeHigh": 10000000,
      "analysis": "Let's just say this is anyone's guess: Box Office Pro's weekend preview still has it at $7M-$10M, leaning on residual goodwill from Will Gluck's Anyone But You ($88.3M domestic sleeper run), while Box Office Theory's panel has pulled its pinpoint down hard to a $3M-$5.5M range. Critical reaction was still embargoed as of Wednesday, which might read as a bad sign to those paying attention, and the rom-com ceiling has been soft lately (You, Me & Tuscany opened to $7.7M, The Roses to $6.2M). Landing in the shadow of Brand New Day's second weekend regardless.",
      "rulerLow": 2000000,
      "rulerHigh": 12000000,
      "currentEstimate": null,
      "estimateColorMode": "gradient",
      "estimateColor": "#5C8FF0"
    },
    {
      "title": "Super Troopers 3",
      "distributor": "Searchlight Pictures",
      "theaters": 2700,
      "confidence": "high",
      "momentum": "softening",
      "rtCritic": null,
      "metacritic": null,
      "rangeLow": 3000000,
      "rangeHigh": 6500000,
      "analysis": "Broken Lizard's return after an eight-year gap opens in around 2,700 theaters. Thursday tracking has come down from the long-range outlook: Box Office Theory's panel has it at $3M-$6.5M with a $3.5M pinpoint, expected to land outside the top five. That's well off Super Troopers 2's trajectory ($15.1M open, $30.6M total). The comp trackers are citing is more Jackass: Best and Last ($8.4M open) than Scary Movie's recent $54.3M franchise-best. Also opening the same day: Mubi's limited-release Teenage Sex and Death at Camp Miasma and Eli Roth's Ice Cream Man, which is tracking even lower ($750K-$1.5M).",
      "rulerLow": 2000000,
